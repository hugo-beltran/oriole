{
  "name": "@mycodemedia/oriole",
  "version": "0.0.1",
  "description": "Oriole — a branded component demo site: thin wrappers over react-aria-components, styled with co-located CSS Modules",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun run llms && vite -c showcase/vite.config.ts",
    "build": "bun run llms && vite build -c showcase/vite.config.ts",
    "preview": "vite preview -c showcase/vite.config.ts",
    "llms": "bun scripts/llms.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:css": "vite-css-modules 'src/**/*.module.css' 'showcase/src/**/*.module.css' --config showcase/vite.config.ts --silent",
    "typecheck": "bun run types:css && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "bun run types:css"
  },
  "dependencies": {
    "@fontsource/libre-baskerville": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/router-plugin": "^1.168.30",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "browserslist": "^4.29.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-css-modules": "^1.16.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10"
  }
}
